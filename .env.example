# MySQL connection, e.g. XAMPP: mysql://root:@localhost:3306/bolihon_booking
DATABASE_URL=mysql://user:password@localhost:3306/bolihon_booking
# Random string of 32+ characters used to sign staff login sessions.
AUTH_SECRET=change-me-to-a-long-random-string
# Set to true when DATABASE_URL is configured; false runs the demo mode.
NEXT_PUBLIC_PERSISTENT_BACKEND=true

# Resort entrance pin for the map and "Get directions" (decimal degrees). Blank = search by name.
NEXT_PUBLIC_RESORT_LAT=
NEXT_PUBLIC_RESORT_LNG=

RESEND_API_KEY=your-resend-api-key
BOOKING_FROM_EMAIL="BOLIHON Cove <bookings@your-domain.com>"
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=your-twilio-phone-number
